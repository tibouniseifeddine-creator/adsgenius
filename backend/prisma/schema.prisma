generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CreativeStatus {
  DRAFT
  READY
  APPROVED
  ARCHIVED
}

enum AIProvider {
  MOCK
  OPENAI
  ANTHROPIC
  OTHER
}

enum AITaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum CreativePackStatus {
  DRAFT
  SAVED
}

enum AudienceSource {
  MANUAL
  AI
}

enum CreativePackConceptImageStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum OrderStatus {
  NEW
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUSED
  RETURNED
}

model InfrastructureState {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("infrastructure_state")
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String            @map("password_hash")
  name         String
  locale       String            @default("en")
  timezone     String            @default("UTC")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  memberships  WorkspaceMember[]
  sessions     AuthSession[]
  auditLogs    AuditLog[]
  aiTasks      AITask[]

  @@map("users")
}

model Workspace {
  id                 String            @id @default(uuid())
  name               String
  slug               String            @unique
  defaultCountryCode String            @default("DZ") @map("default_country_code")
  defaultCurrency    String            @default("DZD") @db.VarChar(3) @map("default_currency")
  timezone           String            @default("UTC")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  members            WorkspaceMember[]
  auditLogs          AuditLog[]
  products           Product[]
  creatives          Creative[]
  orders             Order[]
  aiTasks            AITask[]
  creativePacks      CreativePack[]
  audiences          Audience[]
  metaConnection     MetaConnection?
  campaigns          Campaign[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  userId      String           @map("user_id")
  role        WorkspaceRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, status])
  @@map("workspace_members")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  accessTokenHash  String    @unique @map("access_token_hash")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  refreshExpiresAt DateTime  @map("refresh_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([refreshExpiresAt, revokedAt])
  @@map("auth_sessions")
}

model AuditLog {
  id                String     @id @default(uuid())
  workspaceId       String?    @map("workspace_id")
  userId            String?    @map("user_id")
  action            String
  entityType        String     @map("entity_type")
  entityId          String?    @map("entity_id")
  beforeJson        Json?      @map("before_json")
  afterJson         Json?      @map("after_json")
  requestReference  String?    @map("request_reference")
  createdAt         DateTime   @default(now()) @map("created_at")
  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Product {
  id                    String           @id @default(uuid())
  workspaceId           String           @map("workspace_id")
  name                  String
  description           String           @default("")
  sku                   String?
  category              String?
  baseCost              Decimal          @db.Decimal(18, 2) @map("base_cost")
  salePrice             Decimal          @db.Decimal(18, 2) @map("sale_price")
  currency              String           @db.VarChar(3)
  stock                 Int              @default(0)
  shippingCost          Decimal          @default(0) @db.Decimal(18, 2) @map("shipping_cost")
  packagingCost         Decimal          @default(0) @db.Decimal(18, 2) @map("packaging_cost")
  expectedCancellationRate Decimal       @default(0) @db.Decimal(5, 2) @map("expected_cancellation_rate")
  expectedReturnRate    Decimal          @default(0) @db.Decimal(5, 2) @map("expected_return_rate")
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  workspace             Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creatives             Creative[]
  orders                Order[]
  audiences             Audience[]
  campaigns             Campaign[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, active])
  @@index([workspaceId, category])
  @@map("products")
}

model Creative {
  id          String          @id @default(uuid())
  workspaceId String          @map("workspace_id")
  productId   String?         @map("product_id")
  name        String
  // Plain string (not a Postgres enum) so the frontend's format union
  // (image_ad/story/reel/carousel/facebook_feed/instagram_feed/instagram_story/
  // instagram_reel -- see src/types/index.ts) can grow without a DB migration,
  // matching how Product.category is already a free-form string.
  type        String          @default("image_ad")
  status      CreativeStatus  @default(DRAFT)
  angle       String?
  hook        String?
  primaryText String?         @map("primary_text")
  headline    String?
  cta         String?
  url         String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  aiTasks     AITask[]

  @@index([workspaceId, status])
  @@index([workspaceId, productId])
  @@map("creatives")
}

// A manually-entered order (see Orders.tsx "Add Order" form). There is no
// storefront/checkout yet, so every order today is created by hand by the
// workspace owner -- productId is optional (SetNull on delete) so deleting a
// product later never destroys the historical order record. See
// COWORK_ADSGENIUS_REALDATA_PLAN.md.
model Order {
  id              String      @id @default(uuid())
  workspaceId     String      @map("workspace_id")
  productId       String?     @map("product_id")
  customerName    String      @map("customer_name")
  phone           String
  wilaya          String
  commune         String
  address         String
  productName     String      @map("product_name")
  quantity        Int         @default(1)
  price           Decimal     @db.Decimal(18, 2)
  deliveryFee     Decimal     @default(0) @db.Decimal(18, 2) @map("delivery_fee")
  total           Decimal     @db.Decimal(18, 2)
  status          OrderStatus @default(PENDING_CONFIRMATION)
  deliveryCompany String?     @map("delivery_company")
  trackingNumber  String?     @map("tracking_number")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product         Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("orders")
}

// Audience Lab: a saved targeting profile (age/gender/location/interests) a
// user can reuse when building a real Meta campaign later. Created either by
// hand (MANUAL) or by asking AI to suggest 2-3 candidates from a product's
// analysis (AI) -- see POST /api/audiences/generate in api/index.ts. Kept
// intentionally simple/flat (no Campaign linkage yet) since Campaigns are
// still a future feature -- see the Campaign interface note in
// src/types/index.ts.
model Audience {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  productId   String?        @map("product_id")
  name        String
  ageMin      Int            @map("age_min")
  ageMax      Int            @map("age_max")
  gender      String         @default("all")
  location    String[]
  interests   String[]
  explanation String?
  source      AudienceSource @default(MANUAL)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("audiences")
}

// AI Creative Pack Engine: a user uploads one product photo + a name and
// gets back a full "creative pack" (analysis, strategy, several distinct
// hook/copy/visual concepts, optionally an AI-generated image per concept).
// Deliberately not named "Campaign" -- see the Campaign interface note in
// src/types/index.ts for why (a real Meta ad campaign is a separate future
// concept).
model CreativePack {
  id              String            @id @default(uuid())
  workspaceId     String            @map("workspace_id")
  productName     String            @map("product_name")
  // Either a Vercel Blob https URL (when BLOB_READ_WRITE_TOKEN is configured)
  // or a raw "data:image/...;base64,..." string (graceful fallback so the
  // whole feature works with zero extra setup) -- see storeImage() in api/index.ts.
  productImageUrl String?           @map("product_image_url")
  category        String?
  targetAudience  String?           @map("target_audience")
  country         String?
  language        String            @default("ar")
  sellingPrice    Decimal?          @db.Decimal(18, 2) @map("selling_price")
  currency        String?           @db.VarChar(3)
  mainBenefit     String?           @map("main_benefit")
  websiteUrl      String?           @map("website_url")
  analysis        Json?
  strategy        Json?
  status          CreativePackStatus    @default(DRAFT)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  concepts        CreativePackConcept[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("creative_packs")
}

model CreativePackConcept {
  id             String                         @id @default(uuid())
  creativePackId String                         @map("creative_pack_id")
  index          Int
  angle          String
  hook           String?
  primaryText    String?                        @map("primary_text")
  headline       String?
  cta            String?
  visualConcept  String?                        @map("visual_concept")
  targetAudience String?                        @map("target_audience")
  // Same either-Blob-URL-or-inline-base64 convention as CreativePack.productImageUrl.
  imageUrl       String?                        @map("image_url")
  imageStatus    CreativePackConceptImageStatus @default(PENDING) @map("image_status")
  imageError     String?                        @map("image_error")
  createdAt      DateTime                       @default(now()) @map("created_at")
  updatedAt      DateTime                       @updatedAt @map("updated_at")
  creativePack   CreativePack                   @relation(fields: [creativePackId], references: [id], onDelete: Cascade)

  @@unique([creativePackId, index])
  @@index([creativePackId])
  @@map("creative_pack_concepts")
}

model AIPromptVersion {
  id          String      @id @default(uuid())
  capability  String
  version     String
  template    String
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  aiTasks     AITask[]

  @@unique([capability, version])
  @@index([capability, active])
  @@map("ai_prompt_versions")
}

model AITask {
  id              String         @id @default(uuid())
  workspaceId     String         @map("workspace_id")
  userId          String?        @map("user_id")
  creativeId      String?        @map("creative_id")
  promptVersionId String?        @map("prompt_version_id")
  capability      String
  provider        AIProvider
  model           String
  status          AITaskStatus   @default(PENDING)
  inputJson       Json            @map("input_json")
  outputJson      Json?           @map("output_json")
  errorCode       String?         @map("error_code")
  errorMessage    String?         @map("error_message")
  startedAt       DateTime?       @map("started_at")
  completedAt     DateTime?       @map("completed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  creative        Creative?      @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  promptVersion   AIPromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  usage           AIUsage?

  @@index([workspaceId, createdAt])
  @@index([workspaceId, capability, status])
  @@map("ai_tasks")
}

model AIUsage {
  id           String   @id @default(uuid())
  taskId       String   @unique @map("task_id")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  estimatedCost Decimal? @db.Decimal(18, 8) @map("estimated_cost")
  currency     String   @default("USD") @db.VarChar(3)
  createdAt    DateTime @default(now()) @map("created_at")
  task         AITask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("ai_usage")
}

// See audit finding P04 -- a real (not mock) connection to one Meta ad
// account per workspace, set up via OAuth (GET /api/integrations/meta/connect
// + /callback below). accessToken is a long-lived user token from Meta's own
// token exchange; it is never returned to the frontend, only used
// server-side to call the Marketing API for account name + spend insights.
// One ad account per workspace for now -- picking which of several ad
// accounts to use, and campaign-level (not just account-level) data, is
// follow-up work once this MVP connection is in use.
model MetaConnection {
  id             String    @id @default(uuid())
  workspaceId    String    @unique @map("workspace_id")
  adAccountId    String    @map("ad_account_id")
  adAccountName  String?   @map("ad_account_name")
  currency       String?   @db.VarChar(3)
  accessToken    String    @map("access_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  connectedAt    DateTime  @default(now()) @map("connected_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("meta_connections")
}

// See audit findings P03/P08 -- Campaigns.tsx used to show only sample data,
// and the Campaign Builder's final "Launch" step was explicitly a MOCK MODE
// simulation with no real row saved anywhere. A Campaign here is real either
// way: source DRAFT is a plan you built and saved (no Meta ID yet, nothing
// spent), source META_SYNCED is a real campaign pulled in from your
// connected Meta ad account via POST /api/campaigns/sync (read-only,
// ads_read scope -- see MetaConnection above). Actually PUBLISHING a DRAFT
// to Meta (creating it there for real, which can spend real money) is
// intentionally not built yet -- that needs an explicit decision on
// write-scope and launch-safety defaults (start paused vs. active) before
// it's built, and is tracked as separate follow-up work, not part of this.
enum CampaignSource {
  DRAFT
  META_SYNCED
}

model Campaign {
  id             String         @id @default(uuid())
  workspaceId    String         @map("workspace_id")
  source         CampaignSource @default(DRAFT)
  metaCampaignId String?        @map("meta_campaign_id")
  name           String
  productId      String?        @map("product_id")
  objective      String?
  destination    String?
  budgetType     String?        @map("budget_type")
  budget         Decimal?       @db.Decimal(12, 2)
  audienceIds    Json?          @map("audience_ids")
  creativeIds    Json?          @map("creative_ids")
  status         String         @default("draft")
  currency       String?        @db.VarChar(3)
  spend          Decimal?       @db.Decimal(12, 2)
  impressions    Int?
  clicks         Int?
  lastSyncedAt   DateTime?      @map("last_synced_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product        Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  adSets         AdSet[]

  @@unique([workspaceId, metaCampaignId])
  @@index([workspaceId, source])
  @@map("campaigns")
}

// Read-only cache of a campaign's ad sets, populated by the same sync as
// Campaign above. Not created for DRAFT campaigns (they have no ad sets
// until they're actually published to Meta -- see the Campaign comment).
model AdSet {
  id           String   @id @default(uuid())
  campaignId   String   @map("campaign_id")
  metaAdSetId  String   @map("meta_adset_id")
  name         String
  status       String
  budget       Decimal? @db.Decimal(12, 2)
  spend        Decimal? @db.Decimal(12, 2)
  impressions  Int?
  clicks       Int?
  lastSyncedAt DateTime @map("last_synced_at")
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads          Ad[]

  @@unique([campaignId, metaAdSetId])
  @@map("ad_sets")
}

model Ad {
  id           String   @id @default(uuid())
  adSetId      String   @map("ad_set_id")
  metaAdId     String   @map("meta_ad_id")
  name         String
  status       String
  spend        Decimal? @db.Decimal(12, 2)
  impressions  Int?
  clicks       Int?
  lastSyncedAt DateTime @map("last_synced_at")
  adSet        AdSet    @relation(fields: [adSetId], references: [id], onDelete: Cascade)

  @@unique([adSetId, metaAdId])
  @@map("ads")
}
