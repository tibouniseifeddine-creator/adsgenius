# AdsGenius environment variable template
# Copy to a local .env file and replace placeholders as needed.
# Never commit real secrets.

# Vite exposes only variables prefixed with VITE_ to browser code.
# Do not put provider API keys, database credentials, auth secrets,
# or other privileged credentials in VITE_ variables.

VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:3000/api/v1
