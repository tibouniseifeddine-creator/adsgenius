# AdsGenius environment variable template
# Copy to a local .env file and replace placeholders as needed.
# Never commit real secrets.

# Client-visible variables must use VITE_ and must never contain secrets.
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:3000

# Backend
API_HOST=127.0.0.1
API_PORT=3000
APP_VERSION=0.1.0
API_REQUIRE_DATABASE=false

# Development PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adsgenius
