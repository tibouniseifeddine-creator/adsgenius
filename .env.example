# AdsGenius -- required environment variables.
# Copy this file to .env for local development, and set the same keys in
# your deployment platform's environment settings for production/preview.
# Never commit a real .env file -- only this .env.example template.

# ---- Database (required) ----
# Postgres connection string (Neon, or any Postgres-compatible provider).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Auth (required) ----
# Secret used to sign/verify login JWTs. Use a long, random value --
# rotating it invalidates every existing session.
JWT_SECRET=

# ---- CORS (required in production) ----
# Comma-separated list of allowed frontend origins, e.g.
# https://adsgenius-kappa.vercel.app,https://app.example.com
# If unset, the API rejects all cross-origin requests (fails closed).
FRONTEND_ORIGIN=

# ---- AI: Anthropic Claude (required for AI copywriting/analysis/audiences) ----
ANTHROPIC_API_KEY=
# Optional -- defaults to claude-3-5-haiku-latest if unset.
ANTHROPIC_MODEL=

# ---- AI: OpenAI (required only for AI Creative Pack image generation) ----
OPENAI_API_KEY=
# Optional -- defaults to gpt-image-1 if unset.
OPENAI_IMAGE_MODEL=

# ---- Delivery: ZR Express / Procolis (required only for real shipment creation) ----
ZR_EXPRESS_TOKEN=
ZR_EXPRESS_KEY=

# ---- Meta (Facebook) Ads integration (required for real ad account connection) ----
# From your app at developers.facebook.com -- App settings -> Basic.
META_APP_ID=
META_APP_SECRET=
# Must exactly match one of the "Valid OAuth Redirect URIs" configured in
# that app's Facebook Login product settings, e.g.
# https://adsgenius-kappa.vercel.app/api/integrations/meta/callback
META_REDIRECT_URI=
# Strongly recommended before connecting any real customer's ad account --
# without it, Meta access tokens are stored in PLAINTEXT in the database.
# Also used to encrypt users' two-factor authentication (2FA/TOTP) secrets at
# rest -- see docs/SECURITY.md.
# Generate with: openssl rand -base64 32
# Rotating/removing this key makes any already-stored Meta connections
# undecryptable (customers will need to reconnect Meta) AND breaks 2FA for any
# account that already has it enabled (they would need to disable and
# re-enable it) -- treat this key as long-lived once real users depend on it.
META_TOKEN_ENCRYPTION_KEY=

# ---- Storage: Vercel Blob (optional -- falls back to inline base64 images if unset) ----
# Create a Blob store from the Vercel dashboard (Project -> Storage -> Create
# Database -> Blob) and connect it to this project; Vercel then injects this
# variable into your deployments automatically. For local development, run
# `vercel env pull` to copy it into your .env file.
BLOB_READ_WRITE_TOKEN=

# ---- Frontend build-time variable (Vite) ----
# Only needed if the frontend is deployed separately from the API (different
# host). Leave unset when both are served from the same Vercel deployment.
VITE_API_URL=

# ---- Local development only ----
# Port for the standalone Express server (backend/src/server.ts). Not used
# on Vercel, which invokes api/index.ts as a serverless function.
PORT=4000
