{
  "name": "adsgenius",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "backend"
  ],
  "scripts": {
    "install:clean": "npm ci",
    "dev": "vite",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "typecheck:client": "tsc --noEmit",
    "typecheck:backend": "tsc -p backend/tsconfig.json --noEmit",
    "typecheck:packages": "tsc -p packages/shared-types/tsconfig.json --noEmit && tsc -p packages/api-client/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:packages && npm run typecheck:backend",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:client": "vite build",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build": "npm run typecheck && npm run lint && npm run test && npm run build:client && npm run build:backend",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:seed": "tsx backend/prisma/seed.ts",
    "preview": "vite preview",
    "start:backend": "node backend/dist/server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.1.2",
    "eslint": "8.57.1",
    "postcss": "^8.4.32",
    "prettier": "3.6.2",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "2.1.9",
    "@vitejs/plugin-react": "^4.2.0"
  }
}
